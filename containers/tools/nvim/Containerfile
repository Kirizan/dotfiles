# kc-nvim — built by `kc build nvim` (build context: the repo root).
ARG KC_BASE=kc-base:latest
ARG KC_RENDER=kc-render:latest
FROM ${KC_RENDER} AS render

FROM ${KC_BASE}
# ltex-ls bundles a ~250 MB JRE. On by default; KC_NVIM_LTEX=false kc build nvim
# makes a slim image (the nvim config skips ltex when this is "false").
ARG KC_NVIM_LTEX=true
ENV KC_NVIM_LTEX=${KC_NVIM_LTEX} \
    JAVA_HOME=/usr/lib/jvm/default-jvm

COPY containers/tools/nvim/ /opt/kc/tools/nvim/
COPY --from=render /rendered /tmp/kc-rendered
RUN chmod +x /opt/kc/tools/nvim/*.sh \
 && kc-tool-install nvim \
 && rm -rf /tmp/kc-rendered

USER ${KC_UID}:${KC_GID}
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/kc-entrypoint", "nvim"]
CMD []
