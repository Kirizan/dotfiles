#!/bin/bash
# Stop MT7927 Bluetooth firmware-load spam on the mimir desktop.
#
# mimir's WiFi/BT combo card is a MediaTek MT7927 (Filogic 380). The btmtk
# driver declares mediatek/mt7927/BT_RAM_CODE_MT6639_2_1_hdr.bin as required
# firmware, but that blob is not in linux-firmware — it sits in draft MR !946
# awaiting MediaTek's redistribution sign-off:
#   https://gitlab.com/kernel-firmware/linux-firmware/-/merge_requests/946
#
# The kernel retries the load continuously, producing ~100 journal entries per
# minute (~6,600 per boot, ~150k/day). Disabling bluetooth.service does NOT
# help — the retry loop lives in the kernel driver, not bluetoothd.
#
# mimir uses neither Bluetooth nor WiFi (ethernet only; the mouse and keyboard
# are on a Logitech PowerPlay USB receiver), so blacklisting btusb is a clean
# fix rather than a compromise.
#
# TO REVERSE (e.g. if a USB Bluetooth dongle is ever added):
#   sudo rm /etc/modprobe.d/blacklist-mt7927-bluetooth.conf
#   sudo systemctl enable --now bluetooth
#   sudo modprobe btusb
#
# See Known Bugs BT-001 in the Obsidian vault.

{{- if and (eq .chezmoi.os "linux") (eq .chezmoi.hostname "mimir") }}

set -e

BLACKLIST="/etc/modprobe.d/blacklist-mt7927-bluetooth.conf"

echo "Applying MT7927 Bluetooth workaround for mimir..."

if [ -f "$BLACKLIST" ] && grep -q "btusb" "$BLACKLIST"; then
    echo "  btusb blacklist already present"
else
    echo "  Creating $BLACKLIST..."
    sudo tee "$BLACKLIST" > /dev/null << 'EOF'
# MT7927 (MT6639) Bluetooth firmware is absent from linux-firmware, so btmtk
# retries the load ~100x/minute forever. mimir does not use Bluetooth.
# Generated by chezmoi dotfiles. See Known Bugs BT-001.
blacklist btusb
EOF
    echo "  blacklist created"
fi

# bluetoothd has nothing to manage once btusb is blacklisted, and leaving it
# enabled just means a failed unit at boot.
if systemctl is-enabled bluetooth >/dev/null 2>&1; then
    echo "  Disabling bluetooth.service..."
    sudo systemctl disable --now bluetooth
else
    echo "  bluetooth.service already disabled"
fi

# Unload now so the fix takes effect without a reboot. Ignore failure when the
# module is already gone or still referenced.
if lsmod | grep -q '^btusb '; then
    echo "  Unloading btusb..."
    sudo modprobe -r btusb 2>/dev/null || echo "  (btusb busy; will stay unloaded after next boot)"
fi

echo "MT7927 Bluetooth workaround applied."

{{- else }}
echo "Skipping MT7927 Bluetooth workaround (not applicable on this system)"
{{- end }}
