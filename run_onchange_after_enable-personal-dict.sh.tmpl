#!/bin/bash
# Enable the personal dictionary sync: a path unit that fires when the
# Obsidian word list changes, and a timer that collects words added inside apps.
#
# Re-runs whenever a unit file changes, via the hashes below.
# unit hash: {{ include "dot_config/systemd/user/personal-dict.service" | sha256sum }}
# unit hash: {{ include "dot_config/systemd/user/personal-dict.timer" | sha256sum }}
# unit hash: {{ include "dot_config/systemd/user/personal-dict.path.tmpl" | sha256sum }}

set -euo pipefail

UNITS=(personal-dict.path personal-dict.timer)

if ! command -v systemctl >/dev/null 2>&1; then
  echo "systemd not present — skipping ${UNITS[*]}"
  exit 0
fi

if ! systemctl --user show-environment >/dev/null 2>&1; then
  echo "no systemd user session — skipping ${UNITS[*]} (enable manually later)"
  exit 0
fi

systemctl --user daemon-reload
systemctl --user enable --now "${UNITS[@]}"
{{- if eq .profile "work" }}
NOTE="{{ .obsidian.vault_root }}/{{ .obsidian.work_vault }}/3-Resources/Spelling/Personal Dictionary.md"
{{- else }}
NOTE="{{ .obsidian.vault_root }}/{{ .obsidian.primary_vault }}/3-Resources/Spelling/Personal Dictionary.md"
{{- end }}

# On a fresh machine the vault hasn't synced yet. The path unit is already
# watching for the note and runs the first sync when it appears.
if [ ! -f "$NOTE" ]; then
  echo "Word list not synced yet — personal-dict.path will sync it when $NOTE appears"
  exit 0
fi

systemctl --user start personal-dict.service
