#!/bin/bash
# Give Polymath full control of the Flux keyboard in every mode it enumerates in.
#
# 1. uaccess: the polymath AUR package ships its udev rule as 95-polymath.rules,
#    but the uaccess tag is only acted on by 73-seat-late.rules. A tag added at 95
#    is too late, so no ACL is ever set and the device nodes stay root:uucp 0660.
#    Polymath then fails to push ("Failed to create sync signal on <keyboard>").
#    This rule re-applies the same tags early enough (72 < 73) to take effect,
#    and adds the Raspberry Pi bootloader IDs the keyboard reboots into.
#
# 2. Firmware drive: to update "Oates" (the RP2040 key controller), Polymath
#    reboots it into the RP2 bootloader, which appears as a UF2 mass-storage
#    drive (label RPI-RP2, or RP2350 on newer chips). Polymath only looks for
#    that drive under /media/$USER/ (Ubuntu's udisks layout). Arch mounts nothing
#    automatically and uses /run/media/$USER, so the update waits forever.
#    systemd-mount puts it where Polymath looks, owned by the user, and the mount
#    goes away on its own when the keyboard reboots out of the bootloader.
#
# "Garfield" (the screen module) is flashed with the bundled rkdeveloptool over
# Rockchip loader mode (2207:350a), which the uaccess rule covers.

{{- if and .isArchBased (eq .profile "personal") (not .isWSL) (not .isHeadless) }}

set -e

UDEV_RULE="/etc/udev/rules.d/72-polymath-uaccess.rules"
USER_UID="$(id -u {{ .chezmoi.username }})"
USER_GID="$(id -g {{ .chezmoi.username }})"

echo "Installing Flux keyboard udev rules..."
sudo tee "$UDEV_RULE" > /dev/null << EOF
# Flux keyboard (Polymath). Generated by chezmoi dotfiles.

# Tag for uaccess before 73-seat-late.rules runs. Mirrors
# /usr/lib/udev/rules.d/95-polymath.rules from the polymath AUR package.
SUBSYSTEMS=="usb|usb_device", ATTRS{idVendor}=="3761", GROUP="uucp", TAG+="uaccess"
SUBSYSTEMS=="usb|usb_device", ATTRS{idVendor}=="2207", ATTRS{idProduct}=="350a", GROUP="uucp", TAG+="uaccess"
SUBSYSTEMS=="tty", ATTRS{idVendor}=="3761", GROUP="uucp", TAG+="uaccess"

# RP2040 / RP2350 bootloader (picoboot interface), used for Oates firmware updates
SUBSYSTEM=="usb", ATTR{idVendor}=="2e8a", ATTR{idProduct}=="0003|000f", GROUP="uucp", TAG+="uaccess"

# Mount the RP2 UF2 drive where Polymath looks for it
ACTION=="add", SUBSYSTEM=="block", ENV{DEVTYPE}=="partition", ENV{ID_VENDOR_ID}=="2e8a", ENV{ID_FS_LABEL}=="RPI-RP2|RP2350", ENV{UDISKS_IGNORE}="1", RUN+="/usr/bin/systemd-mount --no-block --collect -o uid=${USER_UID},gid=${USER_GID},umask=022,flush \$devnode /media/{{ .chezmoi.username }}/\$env{ID_FS_LABEL}"
EOF

sudo udevadm control --reload-rules
# Re-run rules for anything already plugged in, so no replug is needed
sudo udevadm trigger --action=change --attr-match=idVendor=3761 || true
sudo udevadm trigger --action=change --subsystem-match=hidraw --subsystem-match=tty || true
echo "Flux keyboard udev rules installed"

{{- end }}
