#!/bin/bash
# Grant the logged-in user access to the Flux keyboard so Polymath can program it.
#
# The polymath AUR package ships its udev rule as 95-polymath.rules, but the
# uaccess tag is only acted on by 73-seat-late.rules. A tag added at 95 is too
# late, so no ACL is ever set and the device nodes stay root:uucp 0660. Polymath
# then fails to push ("Failed to create sync signal on <keyboard>").
#
# This rule re-applies the same tags early enough (72 < 73) to take effect.

{{- if and .isArchBased (eq .profile "personal") (not .isWSL) (not .isHeadless) }}

set -e

UDEV_RULE="/etc/udev/rules.d/72-polymath-uaccess.rules"

echo "Installing Flux keyboard uaccess udev rule..."
sudo tee "$UDEV_RULE" > /dev/null << 'EOF'
# Flux keyboard (Polymath): tag for uaccess before 73-seat-late.rules runs.
# Mirrors /usr/lib/udev/rules.d/95-polymath.rules from the polymath AUR package.
# Generated by chezmoi dotfiles
SUBSYSTEMS=="usb|usb_device", ATTRS{idVendor}=="3761", GROUP="uucp", TAG+="uaccess"
SUBSYSTEMS=="usb|usb_device", ATTRS{idVendor}=="2207", ATTRS{idProduct}=="350a", GROUP="uucp", TAG+="uaccess"
SUBSYSTEMS=="tty", ATTRS{idVendor}=="3761", GROUP="uucp", TAG+="uaccess"
EOF

sudo udevadm control --reload-rules
# Re-run rules for anything already plugged in, so no replug is needed
sudo udevadm trigger --action=change --attr-match=idVendor=3761 || true
sudo udevadm trigger --action=change --subsystem-match=hidraw --subsystem-match=tty || true
echo "Flux keyboard uaccess rule installed"

{{- end }}
