#!/bin/bash
# Personal profile only — 1Password desktop app (AUR, published by 1Password).
# The repo configures 1Password elsewhere (polkit rule, autostart, shortcuts);
# this installs the app itself.

{{- if and (eq .profile "personal") .isArchBased (not .isWSL) (not .isHeadless) }}

# 1Password's release signing key; the PKGBUILD's validpgpkeys names the same one.
KEY_URL="https://downloads.1password.com/linux/keys/1password.asc"
KEY_FPR="3FEF9748469ADBE15DA7CA80AC2D62742012EA22"

if pacman -Q 1password &> /dev/null; then
    echo "1Password already installed"
    exit 0
fi

if ! command -v paru &> /dev/null; then
    echo "paru not found; cannot install 1Password from the AUR. Install paru first."
    exit 1
fi

# makepkg checks the download signature against the user's keyring.
# Import the key only if the published file carries the expected fingerprint.
if ! gpg --list-keys "$KEY_FPR" &> /dev/null; then
    KEY_FILE="$(mktemp)"
    curl -fsSL -o "$KEY_FILE" "$KEY_URL" || { echo "Failed to download the 1Password signing key"; rm -f "$KEY_FILE"; exit 1; }
    if ! gpg --show-keys --with-colons "$KEY_FILE" | grep -q "^fpr:::::::::$KEY_FPR:"; then
        echo "1Password signing key fingerprint mismatch; not importing"
        rm -f "$KEY_FILE"
        exit 1
    fi
    gpg --import "$KEY_FILE"
    rm -f "$KEY_FILE"
fi

echo "Installing 1Password..."
paru -S --needed --noconfirm 1password
echo "1Password installation complete."

{{- else if eq .profile "personal" }}
echo "Skipping 1Password install (not an Arch-based desktop)"
{{- else }}
echo "Skipping 1Password install (not on personal profile)"
{{- end }}
