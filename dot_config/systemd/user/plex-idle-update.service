[Unit]
Description=Apply an approved Plex update on avalon when nobody is streaming
Documentation=file://%h/Obsidian/Primary/2-Areas/Home-Network/Runbooks/avalon-weekly-update.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/plex-idle-update
TimeoutStartSec=20min
Environment=BAO_ADDR=https://vault.internal.kirby.network
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
