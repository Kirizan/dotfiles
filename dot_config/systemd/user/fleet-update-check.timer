[Unit]
Description=Weekly fleet update check
Documentation=https://grafana.internal.kirby.network/d/fleet-updates

[Timer]
# Saturday evening, so the report is ready for avalon's run at about 23:59
# (the 10 min delay plus about 15 min runtime ends by about 22:45). Deliberately an odd minute rather than :00 so it does not
# pile onto every other scheduled job on the hour.
OnCalendar=Sat 22:17
# Catch up if the desktop was asleep or powered off at the scheduled time —
# without this, a machine that is off on Saturdays would silently never check.
Persistent=true
RandomizedDelaySec=10m
AccuracySec=1m

[Install]
WantedBy=timers.target
