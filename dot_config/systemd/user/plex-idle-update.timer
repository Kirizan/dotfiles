[Unit]
Description=Nightly check for an approved Plex update to apply

[Timer]
# Plex is idlest in the early morning. The script exits at once without a
# marker from the weekly avalon run, so a nightly run costs nothing.
OnCalendar=*-*-* 03:37
# No catch-up: a missed night shouldn't fire mid-morning, when people may be
# watching. The script checks streams anyway, but the night is the point.
Persistent=false
AccuracySec=1m

[Install]
WantedBy=timers.target
