#!/usr/bin/env python3
"""Publish what an update run held back, for the Home Hardware dashboards.

Called at the end of weekly-mimir-update and weekly-avalon-update. Reads a JSON
list on stdin, one object per held item (an empty list clears the panel):

  push-update-state avalon <<< '[{"item": "portainer", "from": "1.6.1",
      "to": "1.7.19", "risk": "high", "reason": "one-way DB migration"}]'

Pushes fleet_update_held_info and fleet_report_timestamp_seconds{target="held-<target>"},
and keeps a copy that fleet-update-check uses to mark held packages.
"""
import json
import os
import ssl
import sys
import time
import urllib.request
from datetime import date
from pathlib import Path

VM = "https://victoria.internal.kirby.network/api/v1/import/prometheus"


def esc(v):
    return str(v or "").replace("\\", "\\\\").replace('"', '\\"').replace("\n", " ")[:300]


def main():
    if len(sys.argv) != 2 or sys.argv[1] not in ("mimir", "avalon"):
        sys.exit("usage: push-update-state mimir|avalon < items.json")
    target = sys.argv[1]
    items = json.load(sys.stdin)
    ts = int(time.time())
    run = date.today().isoformat()
    lines = [f'fleet_report_timestamp_seconds{{target="held-{target}"}} {ts}']
    for i in items:
        labels = {"target": target, "item": i["item"], "from": i.get("from"), "to": i.get("to"),
                  "risk": i.get("risk"), "reason": i.get("reason"), "run": run}
        lines.append("fleet_update_held_info{%s} %d" % (
            ",".join(f'{k}="{esc(v)}"' for k, v in labels.items()), ts))
    req = urllib.request.Request(VM, data="\n".join(lines).encode() + b"\n", method="POST")
    urllib.request.urlopen(req, context=ssl._create_unverified_context(), timeout=20)
    state = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "fleet-update-check"
    state.mkdir(parents=True, exist_ok=True)
    (state / f"held-{target}.json").write_text(json.dumps(items, indent=2))
    print(f"pushed {len(items)} held item(s) for {target}")


if __name__ == "__main__":
    main()
