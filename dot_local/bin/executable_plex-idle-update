#!/bin/bash
# plex-idle-update — finish a Plex update that the weekly avalon run approved
# but could not apply because someone was watching.
#
# The weekly-avalon-update run (Sunday afternoon) reviews Plex like any other
# container. Plex's policy is auto-when-idle, and Sunday afternoon rarely is, so
# when the review passes but Tautulli reports active streams, the run writes
# ~/.local/state/avalon-update/plex-approved instead of holding the update.
# This script runs nightly from plex-idle-update.timer. If there's a marker and
# nobody is streaming, it pulls and deploys Plex the same way the run would,
# verifies it, and rolls back from the run's snapshot on failure.
#
# No marker: does nothing. Streams active or the count unknown: waits for the
# next night. A marker older than 6 days is dropped, because the next Sunday
# run reviews Plex again from scratch.
set -uo pipefail

STATE_DIR="$HOME/.local/state/avalon-update"
MARK="$STATE_DIR/plex-approved"
LOG="$STATE_DIR/plex-idle-update.log"
INFRA="$HOME/projects/infrastructure"
VM="https://victoria.internal.kirby.network"
VAULT="$HOME/Obsidian/Primary"
TODAY="$(date +%Y-%m-%d)"
ACTIVITY="$VAULT/daily/$(date +%Y)/$TODAY-activity.md"

log() { printf '%s %s\n' "$(date -Is)" "$*" >>"$LOG"; }
notify() { command -v notify-send >/dev/null && notify-send --app-name="Fleet Updates" --icon=system-software-update "$@"; }

[[ -f "$MARK" ]] || exit 0
mkdir -p "$STATE_DIR"

read -r approved target snapshot < <(python3 -c '
import json, sys
d = json.load(open(sys.argv[1]))
print(d["approved"], d.get("target", "?"), d["snapshot"])' "$MARK" 2>/dev/null)
if [[ -z "${snapshot:-}" ]]; then
  log "ERROR: unreadable marker $MARK; leaving it for the next Sunday run"
  exit 1
fi

age=$(( ( $(date +%s) - $(date -d "$approved" +%s) ) / 86400 ))
if (( age > 6 )); then
  log "marker from $approved is $age days old; dropping it (Sunday's run re-reviews Plex)"
  rm -f "$MARK"
  exit 0
fi

streams() {
  curl -sk --max-time 20 --data-urlencode 'query=tautulli_stream_count' "$VM/api/v1/query" 2>/dev/null \
    | python3 -c 'import json,sys; r=json.load(sys.stdin)["data"]["result"]; print(r[0]["value"][1] if r else "")' 2>/dev/null
}
n="$(streams)"
if [[ "$n" != "0" ]]; then
  log "plex $target approved $approved: streams=${n:-unknown}, trying again tomorrow night"
  exit 0
fi

# Same scoped AppRole as fleet-update-check; it can read the Portainer key.
APPROLE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/fleet-update-check/approle"
if [[ -z "${BAO_TOKEN:-}" && -r "$APPROLE_DIR/role-id" && -r "$APPROLE_DIR/secret-id" ]]; then
  if BAO_TOKEN="$(timeout 20 bao write -field=token auth/approle/login \
      role_id=@"$APPROLE_DIR/role-id" secret_id=@"$APPROLE_DIR/secret-id" 2>/dev/null)"; then
    export BAO_TOKEN
    trap 'bao token revoke -self >/dev/null 2>&1' EXIT
  fi
fi

activity() {
  if [[ ! -f "$ACTIVITY" ]]; then
    mkdir -p "$(dirname "$ACTIVITY")"
    printf -- '---\ntags:\n  - type/log\n  - area/homelab\ndate: %s\n---\n\n# %s Activity\n' "$TODAY" "$TODAY" >"$ACTIVITY"
  fi
  printf '\n## Plex idle update\n\n%s\n' "$1" >>"$ACTIVITY"
}

fail() {
  log "FAILED: $1"
  notify --urgency=critical "Plex update failed" "$1
See $LOG"
  activity "- [[Plex]] $target (approved by the [[avalon-weekly-update|weekly avalon run]] on $approved) **failed**: $1. Log: \`$LOG\`"
  rm -f "$MARK"
  exit 1
}

cd "$INFRA" || fail "no $INFRA"
log "plex $target approved $approved: 0 streams, updating"

scripts/portainer-stack.py pull media-stack plex >>"$LOG" 2>&1 || fail "pull failed"

# Deploy only if Plex is the one real change. qbittorrent always shows as a
# false-positive recreate (network_mode: service:), and Portainer leaves it alone.
plan="$(scripts/portainer-stack.py deploy media-stack --dry-run --unguard plex 2>&1)" || fail "dry run failed"
printf '%s\n' "$plan" >>"$LOG"
extra="$(printf '%s\n' "$plan" | sed -n 's/^plan: recreate \(.*\); create .*/\1/p' | tr ',' '\n' \
  | sed 's/^ *//' | grep -v -E '^plex \(|^none$|likely false positive' || true)"
[[ -z "$extra" ]] || fail "deploy would also recreate: $(echo $extra) — left for the next run"

[[ "$(streams)" == "0" ]] || { log "a stream started during the pull; trying again tomorrow night"; exit 0; }

scripts/portainer-stack.py deploy media-stack --unguard plex >>"$LOG" 2>&1 || fail "deploy failed"

ok=0
for _ in $(seq 30); do
  sleep 10
  state="$(ssh avalon "sudo docker inspect -f '{{.State.Status}} {{.RestartCount}}' plex" 2>/dev/null)"
  code="$(curl -sk -o /dev/null -w '%{http_code}' --max-time 10 https://plex.internal.kirby.network/identity)"
  if [[ "$state" == "running 0" && "$code" == "200" ]]; then ok=1; break; fi
done

if (( ok == 0 )); then
  log "verify failed (state='$state' identity=$code); rolling back from $snapshot"
  scripts/portainer-stack.py rollback "$snapshot" plex >>"$LOG" 2>&1 \
    && fail "Plex didn't come up healthy (state '$state', /identity $code); rolled back to the previous image" \
    || fail "Plex didn't come up healthy AND the rollback failed — check avalon now"
fi

version="$(curl -sk --max-time 10 https://plex.internal.kirby.network/identity | sed -n 's/.*version="\([^"]*\)".*/\1/p')"
log "plex updated to ${version:-?}, verified"
rm -f "$MARK"
activity "- [[Plex]] updated to ${version:-$target} overnight with 0 active streams, after the [[avalon-weekly-update|weekly avalon run]] approved it on $approved. Running, 0 restarts, \`/identity\` answers"
notify "Plex updated" "Plex ${version:-$target} installed with no active streams"
exit 0
