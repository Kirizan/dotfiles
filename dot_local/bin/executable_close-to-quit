#!/bin/bash
# close-to-quit — quit an app whose last window just closed, if all it did was
# hide in the system tray.
#
# Started as close-to-quit@<pid>.service by the close-to-quit KWin script
# (~/.local/share/kwin/scripts/close-to-quit) once a process has no windows left.
#
# Acts only when the process still owns a tray icon (StatusNotifierItem): an app
# that really closed has no tray icon and is already exiting. Apps that are
# meant to live in the tray are listed in KEEP_IN_TRAY and left alone.
#
# Sends SIGTERM to that one process, not its whole systemd unit, so anything it
# launched (a game started from a launcher, say) keeps running.

set -euo pipefail

# Apps deliberately configured to close to the tray. Matched case-insensitively
# against the process name (/proc/<pid>/comm) and the executable's file name.
KEEP_IN_TRAY=(
    1password
    claude-desktop
    discord
    signal
    signal-desktop
    steam
)

pid="${1:-}"
[[ "$pid" =~ ^[0-9]+$ ]] || exit 0
[ -d "/proc/$pid" ] || exit 0
[ "$(stat -c %u "/proc/$pid")" = "$(id -u)" ] || exit 0

comm=$(cat "/proc/$pid/comm" 2>/dev/null) || exit 0
exe=$(readlink "/proc/$pid/exe" 2>/dev/null) || exe=""
exe=${exe##*/}

for app in "${KEEP_IN_TRAY[@]}"; do
    if [ "${comm,,}" = "$app" ] || [ "${exe,,}" = "$app" ]; then
        echo "$comm ($pid) closed its last window; kept in the tray by allowlist"
        exit 0
    fi
done

owns_tray_icon() {
    local items item svc owner
    items=$(busctl --user get-property org.kde.StatusNotifierWatcher /StatusNotifierWatcher \
        org.kde.StatusNotifierWatcher RegisteredStatusNotifierItems 2>/dev/null) || return 1
    for item in $(grep -oE '"[^"]+"' <<<"$items" | tr -d '"'); do
        svc=${item%%/*}
        owner=$(busctl --user call org.freedesktop.DBus /org/freedesktop/DBus \
            org.freedesktop.DBus GetConnectionUnixProcessID s "$svc" 2>/dev/null) || continue
        [ "${owner#u }" = "$pid" ] && return 0
    done
    return 1
}

if ! owns_tray_icon; then
    exit 0
fi

echo "$comm ($pid) closed its last window but is still in the tray; quitting it"
kill -TERM "$pid"
