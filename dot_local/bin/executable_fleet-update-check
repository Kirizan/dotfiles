#!/bin/bash
# Weekly fleet update check.
#
# Two halves, deliberately separated so a failure in one still leaves the other
# useful:
#
#   1. Deterministic gathering (shell)  — pacman/AUR counts, days since the last
#      full upgrade, TrueNAS train state, UniFi firmware, and a pull of the
#      container metrics already in VictoriaMetrics. Host-level numbers are
#      pushed BACK into VictoriaMetrics so mimir/avalon/UniFi appear on the same
#      Grafana dashboard as the containers.
#
#   2. Narrative (claude -p)            — reads the gathered state, checks Arch
#      news for manual interventions, and writes a prioritised summary. If this
#      fails the report still contains the full metrics table.
#
# Output goes to the Obsidian vault (report + activity note entry) and a desktop
# notification. Managed by chezmoi; triggered by fleet-update-check.timer.

set -uo pipefail

VAULT="$HOME/Obsidian/Primary"
REPORT_DIR="$VAULT/2-Areas/Home-Network/Update-Reports"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/fleet-update-check"
LOG="$STATE_DIR/check.log"

VM="https://victoria.internal.kirby.network"
GRAFANA="https://grafana.internal.kirby.network"
export BAO_ADDR="${BAO_ADDR:-https://vault.internal.kirby.network}"

TODAY="$(date +%Y-%m-%d)"
YEAR="$(date +%Y)"
REPORT="$REPORT_DIR/$TODAY-fleet-updates.md"
ACTIVITY="$VAULT/daily/$YEAR/$TODAY-activity.md"

STALE_DAYS=30

mkdir -p "$STATE_DIR" "$REPORT_DIR" "$VAULT/daily/$YEAR"
log() { printf '%s %s\n' "$(date -Is)" "$*" >>"$LOG"; }

# OpenBao auth: a scoped AppRole (policy fleet-check: read-only on grafana,
# unifi, portainer, ai/claude), independent of the user's own CLI token.
APPROLE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/fleet-update-check/approle"
if [[ -z "${BAO_TOKEN:-}" && -r "$APPROLE_DIR/role-id" && -r "$APPROLE_DIR/secret-id" ]]; then
  if BAO_TOKEN="$(timeout 20 bao write -field=token auth/approle/login \
      role_id=@"$APPROLE_DIR/role-id" secret_id=@"$APPROLE_DIR/secret-id" 2>/dev/null)"; then
    export BAO_TOKEN
    trap 'bao token revoke -self >/dev/null 2>&1' EXIT
  else
    unset BAO_TOKEN
    log "WARN: fleet-check AppRole login failed; OpenBao-backed sections will be empty"
  fi
fi

# The Claude CLI echoes the rejected bearer token verbatim in auth errors, so
# nothing derived from its stdout/stderr may reach the log or the Obsidian
# report unfiltered.
redact() { sed -E 's/sk-ant-[A-Za-z0-9_-]+/sk-ant-***REDACTED***/g'; }

vmq() {  # instant query -> scalar (empty on failure)
  curl -sk --max-time 20 --data-urlencode "query=$1" "$VM/api/v1/query" 2>/dev/null \
    | python3 -c '
import json,sys
try:
    r=json.load(sys.stdin)["data"]["result"]
    print(r[0]["value"][1] if r else "")
except Exception:
    print("")' 2>/dev/null
}

log "=== run start ==="

# ── 1. mimir (local) ─────────────────────────────────────────────────────
repo_count="$(checkupdates 2>/dev/null | grep -c . )"
aur_count="$(timeout 120 paru -Qua 2>/dev/null | grep -c . )"

last_upgrade="$(grep -F 'starting full system upgrade' /var/log/pacman.log 2>/dev/null \
  | tail -1 | sed -n 's/^\[\([^]]*\)\].*/\1/p')"
if [[ -n "$last_upgrade" ]]; then
  days_since=$(( ( $(date +%s) - $(date -d "$last_upgrade" +%s) ) / 86400 ))
else
  days_since=-1
fi

# ── 2. avalon / TrueNAS ──────────────────────────────────────────────────
truenas_update="$(timeout 90 ssh -o BatchMode=yes -o ConnectTimeout=10 avalon \
  'midclt call update.check_available 2>/dev/null' 2>/dev/null \
  | grep -o '"status": *"[A-Z]*"' | cut -d'"' -f4)"
truenas_update="${truenas_update:-UNKNOWN}"
truenas_version="$(timeout 60 ssh -o BatchMode=yes -o ConnectTimeout=10 avalon \
  'midclt call system.version 2>/dev/null' 2>/dev/null | tr -d '"')"

# ── 2b. avalon: update trains, TrueNAS apps, pool health ─────────────────
# Feeds the weekly-avalon-update run (Claude desktop, Sundays after this).
# UNAVAILABLE on the current train is not always "up to date": when a train
# reaches end of life (Fangtooth after 25.04.2.6) the only way forward is a
# train switch, which check_available reports only when asked per train.
# Read-only midclt calls; kirizan needs no sudo for any of them.
avalon_state="$(timeout 180 ssh -o BatchMode=yes -o ConnectTimeout=10 avalon 'python3 -' 2>/dev/null <<'PY'
import json, subprocess
def mc(*a):
    try:
        r = subprocess.run(["midclt", "call", *a], capture_output=True, text=True, timeout=90)
        return json.loads(r.stdout) if r.returncode == 0 and r.stdout.strip() else None
    except Exception:
        return None
t = mc("update.get_trains") or {}
cur = t.get("current") or ""
newer = []
for name in (t.get("trains") or {}):
    if name == cur:
        continue
    c = mc("update.check_available", json.dumps({"train": name})) or {}
    if c.get("status") == "AVAILABLE":
        newer.append({"train": name, "version": c.get("version"), "notes": c.get("release_notes_url")})
c = mc("update.check_available") or {}
apps = [a for a in (mc("app.query", "[]", json.dumps({"select": ["name", "version", "upgrade_available", "latest_version"]})) or [])]
pools = [{"name": p["name"], "status": p["status"], "healthy": p["healthy"],
          "scan": "%s %s" % ((p.get("scan") or {}).get("function"), (p.get("scan") or {}).get("state"))}
         for p in (mc("pool.query", "[]", json.dumps({"select": ["name", "status", "healthy", "scan"]})) or [])]
print(json.dumps({"train": cur, "patch": c.get("version") if c.get("status") == "AVAILABLE" else None,
                  "newer_trains": newer, "apps": apps, "pools": pools}))
PY
)"
# Prints: patch<TAB>train<TAB>newer-train<TAB>app-updates<TAB>pools-bad, then markdown rows.
avalon_parsed="$(python3 -c '
import json, sys
try:
    d = json.loads(sys.stdin.read())
except Exception:
    sys.exit(0)
nt = d["newer_trains"][-1] if d["newer_trains"] else None
apps_up = [a for a in d["apps"] if a.get("upgrade_available")]
bad = [p for p in d["pools"] if not p["healthy"] or p["status"] != "ONLINE" or "SCANNING" in p["scan"] and "SCRUB" not in p["scan"]]
print("%s\t%s\t%s\t%d\t%d" % (d["patch"] or "none", d["train"] or "?",
      "%s %s" % (nt["train"], nt["version"]) if nt else "none", len(apps_up), len(bad)))
for a in d["apps"]:
    print("APP| %s | %s | %s | %s |" % (a["name"], a.get("version"), a.get("latest_version") or "-",
          "**YES**" if a.get("upgrade_available") else "no"))
for p in d["pools"]:
    print("POOL| %s | %s | %s | %s |" % (p["name"], p["status"], "yes" if p["healthy"] else "**NO**", p["scan"]))
' <<<"$avalon_state" 2>/dev/null)"
truenas_patch="" truenas_train="" truenas_newer_train="" truenas_app_updates="?" avalon_pools_bad="?"
if [[ -n "$avalon_parsed" ]]; then
  IFS=$'\t' read -r truenas_patch truenas_train truenas_newer_train truenas_app_updates avalon_pools_bad \
    <<<"$(head -1 <<<"$avalon_parsed")"
else
  log "WARN: avalon train/app/pool query failed"
fi
avalon_apps="$(sed -n 's/^APP//p' <<<"$avalon_parsed")"
avalon_pools="$(sed -n 's/^POOL//p' <<<"$avalon_parsed")"
truenas_train_eol=0
[[ "$truenas_patch" == "none" && -n "$truenas_newer_train" && "$truenas_newer_train" != "none" ]] && truenas_train_eol=1

# ── 2c. avalon: container image updates ──────────────────────────────────
# image-updates.py never pulls: manifest HEADs and tag lists only, classified
# by update-policy.toml. Its JSON is the weekly-avalon-update run's work list.
IMG_CHECK="$HOME/projects/infrastructure/scripts/image-updates.py"
IMG_JSON="$STATE_DIR/avalon-images.json"
img_table="" img_apply="?" img_hold="?" img_errors="?" img_digest="?" img_versions="?"
if [[ -x "$IMG_CHECK" ]]; then
  if img_table="$(timeout 600 "$IMG_CHECK" --json "$IMG_JSON" 2>>"$LOG")"; then
    IFS=$'\t' read -r img_apply img_hold img_errors img_digest img_versions <<<"$(python3 -c '
import json, sys
s = json.load(open(sys.argv[1]))["summary"]
print("%d\t%d\t%d\t%d\t%d" % (s["apply"], s["hold"], s["errors"], s["digest"], s["minor"] + s["major"]))
' "$IMG_JSON" 2>/dev/null)"
  else
    img_table=""
    log "WARN: image-updates.py failed (see above)"
  fi
fi

# ── 3. containers (already in VictoriaMetrics) ───────────────────────────
ctr_total="$(vmq 'fleet_exporter_containers_total')"
ctr_stale="$(vmq 'count(fleet_container_image_age_days > 180) or vector(0)')"
ctr_oldest="$(vmq 'max(fleet_container_image_age_days)')"
ctr_restarting="$(vmq 'count(rate(fleet_container_restarts_total[1h]) > 0) or vector(0)')"
ctr_unhealthy="$(vmq 'count(fleet_container_health == 0) or vector(0)')"
diun_updates="$(vmq 'sum(diun_image_update_available) or vector(0)')"

oldest_list="$(curl -sk --max-time 20 \
  --data-urlencode 'query=topk(10, fleet_container_image_age_days)' \
  "$VM/api/v1/query" 2>/dev/null | python3 -c '
import json,sys
try:
    for m in json.load(sys.stdin)["data"]["result"]:
        lb=m["metric"]
        print("| %s | %s | %d |" % (lb.get("container","?"), lb.get("stack","-"),
                                    float(m["value"][1])))
except Exception:
    pass' 2>/dev/null)"

# ── 4. firing Grafana alerts ─────────────────────────────────────────────
gpw="$(timeout 20 bao kv get -field=admin_password kv/infra/grafana 2>/dev/null)"
firing=""
if [[ -n "$gpw" ]]; then
  firing="$(curl -sk --max-time 20 -u "admin:$gpw" \
    "$GRAFANA/api/prometheus/grafana/api/v1/rules" 2>/dev/null | python3 -c '
import json,sys
try:
    out=[]
    for g in json.load(sys.stdin)["data"]["groups"]:
        for r in g.get("rules",[]):
            if r.get("state") in ("firing","pending"):
                out.append("- **%s** — %s" % (r.get("name"), r.get("state")))
    print("\n".join(out))
except Exception:
    pass' 2>/dev/null)"
fi
unset gpw

# ── 4b. Portainer stack integrity ────────────────────────────────────────
# Every ${VAR} a stack file needs must have a non-empty env entry, and the
# infrastructure repo must match what Portainer deployed. Catches the failure
# mode behind nexterm's 93-day crash loop (an env var silently dropped).
STACK_CHECK="$HOME/projects/infrastructure/scripts/portainer-stack.py"
stack_check=""
stack_bad=0
if [[ -x "$STACK_CHECK" ]]; then
  stack_check="$(timeout 120 "$STACK_CHECK" check 2>&1)"
  stack_bad="$(printf '%s\n' "$stack_check" | grep -c '^BAD' || true)"
fi
stack_summary="$([[ -n "$stack_check" ]] && echo "$stack_bad" || echo '?')"

# ── 5. UniFi firmware ────────────────────────────────────────────────────
unifi="$(timeout 60 python3 - <<'PY' 2>/dev/null
import subprocess, urllib3, requests
urllib3.disable_warnings()
def bao(f):
    return subprocess.run(["bao","kv","get","-field="+f,"kv/infra/unifi"],
        capture_output=True,text=True).stdout.strip()
u,p = bao("username"), bao("password")
if not u or not p: raise SystemExit
s = requests.Session(); s.verify=False
r = s.post("https://192.168.1.1/api/auth/login", json={"username":u,"password":p}, timeout=15)
if r.status_code != 200: raise SystemExit
h = {"x-csrf-token": r.headers.get("x-csrf-token","")}
d = s.get("https://192.168.1.1/proxy/network/api/s/default/stat/device",
          headers=h, timeout=20).json().get("data",[])
for x in d:
    print("| %s | %s | %s |" % (x.get("name") or x.get("mac"), x.get("version"),
                                "YES" if x.get("upgradable") else "no"))
PY
)"
unifi_pending="$(printf '%s' "$unifi" | grep -c 'YES' || true)"

# ── 5b. Claude CLI versions ──────────────────────────────────────────────
# Native install under ~/.local/share/claude — owned by no package manager, so
# neither checkupdates nor paru sees it. Tracked here or not at all.
#
# Compare against the 'latest' channel: that is what `claude update` installs.
# 'stable' lags it (2.1.236 vs 2.1.263 on 2026-09-08) and would report drift on
# an up-to-date machine. Plain HTTPS, no auth — so version tracking survives the
# CLI being unauthenticated, which is exactly when you most want to see it.
CLAUDE_BIN="$(command -v claude || echo "$HOME/.local/bin/claude")"
CLAUDE_RELEASES="https://storage.googleapis.com/claude-code-dist-86c565f3-f756-42ad-8dfa-d59b1c096819/claude-code-releases"

claude_installed="$("$CLAUDE_BIN" --version 2>/dev/null | awk '{print $1}')"
claude_latest="$(curl -s --max-time 20 "$CLAUDE_RELEASES/latest" 2>/dev/null | tr -d '[:space:]')"
claude_bundled="$(ls -1 "$HOME/.config/Claude/claude-code" 2>/dev/null | sort -V | tail -1)"

# sort -V, not string equality: being *ahead* of the channel is not drift.
claude_outdated=0
if [[ -n "$claude_installed" && -n "$claude_latest" ]]; then
  newest="$(printf '%s\n%s\n' "$claude_installed" "$claude_latest" | sort -V | tail -1)"
  [[ "$newest" != "$claude_installed" ]] && claude_outdated=1
fi

# ── 5d. watched packages ─────────────────────────────────────────────────
# Software whose development the user follows. Not treated differently by the
# update run; it is only named, so a release is noticed instead of disappearing
# into the AUR count. Asks the AUR RPC directly rather than parsing `paru -Qua`,
# so the release date comes along. Fail safe to 0 like the other lookups.
polymath_installed="$(pacman -Q polymath 2>/dev/null | awk '{print $2}')"
polymath_latest="" polymath_date="" polymath_new=0
if [[ -n "$polymath_installed" ]]; then
  read -r polymath_latest polymath_date < <(curl -s --max-time 20 \
    'https://aur.archlinux.org/rpc/v5/info?arg[]=polymath' 2>/dev/null | python3 -c '
import json, sys, datetime
r = json.load(sys.stdin)["results"][0]
print(r["Version"], datetime.date.fromtimestamp(r["LastModified"]).isoformat())' 2>/dev/null)
  if [[ -n "$polymath_latest" && "$polymath_latest" != "$polymath_installed" ]] \
     && [[ "$(printf '%s\n%s\n' "$polymath_installed" "$polymath_latest" | sort -V | tail -1)" == "$polymath_latest" ]]; then
    polymath_new=1
  fi
  [[ -z "$polymath_latest" ]] && log "WARN: AUR lookup for polymath failed"
fi

# ── 5c. motherboard BIOS ─────────────────────────────────────────────────
# Report-only: a BIOS flash is always a manual decision (it resets settings
# and ASUS releases >=1805 cannot be rolled back). ASUS publishes nothing to
# LVFS for this board, so fwupd never sees these releases. The source is the
# ROG support site's own JSON API (the request its helpdesk_bios page makes).
# Every query parameter must be present, even empty, or the API returns
# "No HTTP resource". It also wants a browser UA. The model slug is derived
# from DMI so a board swap doesn't silently check the wrong product.
bios_installed="$(tr -d '[:space:]' </sys/class/dmi/id/bios_version 2>/dev/null)"
bios_board="$(cat /sys/class/dmi/id/board_name 2>/dev/null)"
bios_slug="$(printf '%s' "$bios_board" | tr '[:upper:]' '[:lower:]' | tr -s ' ' '-')"
bios_latest="" bios_latest_date="" bios_newer=0 bios_releases=""
if [[ -n "$bios_installed" && -n "$bios_slug" ]]; then
  bios_json="$(curl -s --max-time 30 \
    -A 'Mozilla/5.0 (X11; Linux x86_64; rv:158.0) Gecko/20100101 Firefox/158.0' \
    "https://rog.asus.com/support/webapi/ProductV2/GetPDBIOS?website=global&model=${bios_slug}&pdid=0&m1id=&cpu=&LevelTagId=&systemCode=rog" \
    2>/dev/null)"
  # Prints: latest<TAB>date<TAB>count-newer, then one markdown row per newer release.
  bios_parsed="$(BIOS_INSTALLED="$bios_installed" python3 -c '
import json, os, re, sys
try:
    d = json.loads(sys.stdin.read())
    files = [f for o in d["Result"]["Obj"] if o.get("Name") == "BIOS" for f in o.get("Files", [])]
except Exception:
    sys.exit(0)
def key(v):
    return [int(x) for x in re.findall(r"\d+", v)] or [0]
inst = os.environ["BIOS_INSTALLED"]
files = [f for f in files if f.get("Version")]
if not files:
    sys.exit(0)
files.sort(key=lambda f: key(f["Version"]), reverse=True)
newer = [f for f in files if key(f["Version"]) > key(inst)]
print("%s\t%s\t%d" % (files[0]["Version"], files[0].get("ReleaseDate", "?"), len(newer)))
for f in newer:
    desc = re.sub(r"<br\s*/?>", " ", f.get("Description") or "")
    desc = re.sub(r"<[^>]+>", "", desc).replace("|", "/").replace("\"", "").strip()
    desc = re.sub(r"\s*Before running the USB BIOS Flashback tool.*$", "", desc)
    url = (f.get("DownloadUrl") or {}).get("Global") or ""
    if url.startswith("/"):
        url = "https://dlcdnets.asus.com" + url
    oneway = " **(one-way)**" if re.search(r"cannot be rolled back|irreversible", desc, re.I) else ""
    print("| %s%s | %s | %s | [zip](%s) |" % (f["Version"], oneway, f.get("ReleaseDate", "?"), desc[:300], url))
' <<<"$bios_json" 2>/dev/null)"
  if [[ -n "$bios_parsed" ]]; then
    IFS=$'\t' read -r bios_latest bios_latest_date bios_newer <<<"$(head -1 <<<"$bios_parsed")"
    bios_releases="$(tail -n +2 <<<"$bios_parsed")"
  else
    log "WARN: ASUS BIOS lookup failed for model '$bios_slug'"
  fi
fi
# Fail safe to 0: a failed lookup must never read as "update available".
bios_outdated=0
[[ -n "$bios_latest" && "${bios_newer:-0}" -gt 0 ]] && bios_outdated=1

log "mimir repo=$repo_count aur=$aur_count days=$days_since | truenas=$truenas_update train=${truenas_train:-?} patch=${truenas_patch:-?} newer-train=${truenas_newer_train:-?} apps=$truenas_app_updates | images apply=$img_apply hold=$img_hold err=$img_errors | ctr stale=$ctr_stale restarting=$ctr_restarting | claude cli=${claude_installed:-?} latest=${claude_latest:-?} outdated=$claude_outdated | bios=${bios_installed:-?} latest=${bios_latest:-?} newer=${bios_newer:-0} | polymath=${polymath_installed:-?} aur=${polymath_latest:-?} new=$polymath_new"

# ── 6. push host-level metrics into VictoriaMetrics ──────────────────────
{
  printf 'fleet_host_pending_updates{host="mimir",source="repo"} %s\n' "${repo_count:-0}"
  printf 'fleet_host_pending_updates{host="mimir",source="aur"} %s\n' "${aur_count:-0}"
  printf 'fleet_host_days_since_upgrade{host="mimir"} %s\n' "${days_since:-0}"
  printf 'fleet_truenas_update_available{host="avalon"} %s\n' \
    "$([[ "$truenas_update" == "AVAILABLE" ]] && echo 1 || echo 0)"
  printf 'fleet_unifi_firmware_updates_pending %s\n' "${unifi_pending:-0}"
  printf 'fleet_truenas_train_eol{host="avalon"} %s\n' "$truenas_train_eol"
  [[ "$truenas_app_updates" =~ ^[0-9]+$ ]] && \
    printf 'fleet_truenas_app_updates{host="avalon"} %s\n' "$truenas_app_updates"
  [[ "$avalon_pools_bad" =~ ^[0-9]+$ ]] && \
    printf 'fleet_avalon_pools_unhealthy{host="avalon"} %s\n' "$avalon_pools_bad"
  if [[ "$img_apply" =~ ^[0-9]+$ ]]; then
    printf 'fleet_avalon_container_updates{host="avalon",action="apply"} %s\n' "$img_apply"
    printf 'fleet_avalon_container_updates{host="avalon",action="hold"} %s\n' "$img_hold"
    printf 'fleet_avalon_container_updates{host="avalon",action="check"} %s\n' "$img_errors"
  fi
  printf 'fleet_claude_cli_outdated{host="mimir"} %s\n' "${claude_outdated:-0}"
  printf 'fleet_bios_releases_behind{host="mimir"} %s\n' "${bios_newer:-0}"
  printf 'fleet_watched_package_update{host="mimir",package="polymath"} %s\n' "$polymath_new"
} | curl -sk --max-time 20 --data-binary @- "$VM/api/v1/import/prometheus" \
  && log "pushed host metrics to VictoriaMetrics" \
  || log "WARN: metric push failed"

# ── 7. deterministic report skeleton ─────────────────────────────────────
{
  cat <<EOF
---
tags:
  - type/log
  - area/homelab
date: $TODAY
---

# Fleet Update Report — $TODAY

Automated weekly check across [[mimir]], [[avalon]], and the [[UDM-Pro|UniFi]] fleet.
Live view: [Fleet Update Status]($GRAFANA/d/fleet-updates)

## Summary

| Target | Metric | Value |
|--------|--------|-------|
| [[mimir]] | Pending repo updates | ${repo_count:-?} |
| [[mimir]] | Pending AUR updates | ${aur_count:-?} |
| [[mimir]] | Days since full upgrade | ${days_since:-?} |
| [[mimir]] | BIOS installed / latest | ${bios_installed:-?} / ${bios_latest:-?} (${bios_latest_date:-?}) |
| [[mimir]] | BIOS update available | $([[ "$bios_outdated" == "1" ]] && echo "**YES** (${bios_newer} newer, review only)" || echo "no") |
| [[mimir]] | PolyMath installed / AUR | ${polymath_installed:-?} / ${polymath_latest:-?} (${polymath_date:-?})$([[ "$polymath_new" == "1" ]] && echo " — **NEW RELEASE**") |
| [[avalon]] | TrueNAS version | ${truenas_version:-?} |
| [[avalon]] | TrueNAS update | ${truenas_update} |
| [[avalon]] | Patch on current train (${truenas_train:-?}) | ${truenas_patch:-?} |
| [[avalon]] | Newer train available | $([[ "$truenas_train_eol" == "1" ]] && echo "**${truenas_newer_train}** (current train at end of life; switch needs approval)" || echo "${truenas_newer_train:-?}") |
| [[avalon]] | TrueNAS app upgrades | ${truenas_app_updates} |
| [[avalon]] | Unhealthy pools | ${avalon_pools_bad} |
| [[avalon]] | Container updates to apply / held / unchecked | ${img_apply} / ${img_hold} / ${img_errors} |
| Containers | Tracked | ${ctr_total:-?} |
| Containers | Images > 180 days | ${ctr_stale:-?} |
| Containers | Oldest image (days) | ${ctr_oldest%%.*} |
| Containers | Restarting | ${ctr_restarting:-?} |
| Containers | Unhealthy | ${ctr_unhealthy:-?} |
| Containers | Upstream updates ([[Diun]]) | ${diun_updates:-?} |
| UniFi | Firmware updates pending | ${unifi_pending:-0} |
| [[Claude Code]] | CLI installed / latest | ${claude_installed:-?} / ${claude_latest:-?} |
| [[Claude Code]] | CLI update available | $([[ "${claude_outdated:-0}" == "1" ]] && echo "**YES**" || echo "no") |
| [[Claude Code]] | Desktop-bundled CLI | ${claude_bundled:-n/a} |
| [[Portainer]] | Stacks with drift or missing env | ${stack_summary} |

$(if [[ "$bios_outdated" == "1" ]]; then cat <<BIOS
## mimir BIOS Releases (review only, never auto-installed)

${bios_board}: installed **${bios_installed}**. Newer releases from ASUS:

| Version | Date | Notes | Download |
|---------|------|-------|----------|
${bios_releases}

Before flashing, save the current settings (see [[mimir-bios-update]]). Flashing past a **one-way** release means you can never go back below it.

BIOS
fi)
$(if [[ "$polymath_new" == "1" ]]; then cat <<POLY
## PolyMath release

[[Polymath|PolyMath]] (Flux keyboard layout tool) **${polymath_latest}** is in the AUR (updated ${polymath_date}); installed ${polymath_installed}. It is a watched package: it goes through the normal AUR update with everything else, and is named here so the release is noticed. Release notes: [fluxkeyboard.com/updates](https://fluxkeyboard.com/updates/), package: [AUR](https://aur.archlinux.org/packages/polymath).

POLY
fi)
## avalon

Processed by the \`weekly-avalon-update\` run (Sundays, after this report), using
\`update-policy.toml\` in the infrastructure repo. Work list: \`${IMG_JSON}\`.

### TrueNAS apps

| App | Installed | Latest | Upgrade |
|-----|-----------|--------|---------|
${avalon_apps:-| _unavailable_ | | | |}

### Pools

| Pool | Status | Healthy | Last scan |
|------|--------|---------|-----------|
${avalon_pools:-| _unavailable_ | | | |}

### Container image updates

${img_digest} digest refreshes, ${img_versions} newer pinned versions. Rows with action **none** are omitted.

${img_table:-_image-updates.py unavailable — see the state log._}

## Oldest Container Images

| Container | Stack | Age (days) |
|-----------|-------|------------|
${oldest_list:-| _none_ | | |}

## UniFi Devices

| Device | Firmware | Update |
|--------|----------|--------|
${unifi:-| _unavailable_ | | |}

## Firing / Pending Alerts

${firing:-_None._}

## Portainer Stack Check

\`\`\`
${stack_check:-portainer-stack.py unavailable}
\`\`\`

EOF
} >"$REPORT"

# ── 8. Claude narrative ──────────────────────────────────────────────────
if [[ -x "$CLAUDE_BIN" ]]; then
  prompt="You are writing the analysis section of an automated weekly update
report for an Arch/CachyOS desktop (mimir) and a TrueNAS Scale server (avalon)
running ~54 Docker containers. Be concise and factual. Change nothing.

State:
- mimir: ${repo_count} repo updates, ${aur_count} AUR updates, ${days_since} days since last full upgrade
- avalon: TrueNAS ${truenas_version}, update status ${truenas_update}; train ${truenas_train:-?}, patch ${truenas_patch:-?}, newer train ${truenas_newer_train:-?}; ${truenas_app_updates} TrueNAS app upgrades; ${avalon_pools_bad} unhealthy pools
- avalon containers: ${img_apply} updates eligible for the weekly run, ${img_hold} held by policy, ${img_errors} unchecked (the run does the per-item risk review; do not repeat it)
- containers: ${ctr_stale} images older than 180 days, oldest ${ctr_oldest%%.*} days, ${ctr_restarting} restarting, ${ctr_unhealthy} unhealthy
- Diun reports ${diun_updates} images with newer digests upstream
- UniFi: ${unifi_pending} firmware updates pending
- mimir BIOS: installed ${bios_installed:-?}, ASUS latest ${bios_latest:-?} (${bios_newer:-0} newer). Flashing is a manual decision; only mention it if newer releases exist
- PolyMath (watched AUR package, Flux keyboard tool): installed ${polymath_installed:-?}, AUR ${polymath_latest:-?}. If it differs, name the new PolyMath release explicitly and summarise its changes from https://fluxkeyboard.com/updates/ if you can fetch them

Tasks:
1. Fetch https://archlinux.org/feeds/news/ and list ONLY news items requiring
   manual intervention. For each, verify with 'pacman -Q <pkg>' whether the
   affected package is installed on this machine. Report only ones that apply.
2. State plainly whether action is needed this week and how urgent.
3. Call out anything that looks like a real problem rather than routine drift.

Output GitHub-flavored markdown starting at '## Analysis'. Under 50 lines.
Use Obsidian wiki-links like [[mimir]] and [[avalon]] for hosts."

  # Two failure modes seen in the wild:
  #   exit 0 + "Not logged in · Please run /login" on stdout      (2026-08)
  #   exit 1 + "OAuth session expired ..." on stdout               (2026-09-06)
  # Checking rc first masks the second behind a bare "exited 1" — which is what
  # left four weekly reports with no analysis and no usable error. Content is
  # inspected before the exit code, and the exit-code branch now carries the
  # actual first line so an unrecognised failure is still diagnosable.
  tmp="$(mktemp)"
  tmperr="$(mktemp)"

  # Long-lived token for headless use; a normal OAuth session expires mid-month
  # and silently kills this step. Stripped defensively — a stored value with
  # embedded whitespace yields an invalid Authorization header.
  CLAUDE_CODE_OAUTH_TOKEN="$(bao kv get -field=cli_oauth_token kv/ai/claude 2>/dev/null | tr -d '[:space:]')"
  export CLAUDE_CODE_OAUTH_TOKEN

  timeout 900 "$CLAUDE_BIN" -p "$prompt" \
    --permission-mode acceptEdits \
    --allowedTools "Bash(pacman -Q:*)" "Bash(checkupdates:*)" "WebFetch" \
    >"$tmp" 2>"$tmperr"
  rc=$?

  unset CLAUDE_CODE_OAUTH_TOKEN
  redact <"$tmperr" >>"$LOG"   # never let a bearer token reach the log
  rm -f "$tmperr"

  if [[ -s "$tmp" ]] && grep -qiE 'not logged in|please run /login|invalid api key|authenticat|oauth|session expired' "$tmp"; then
    reason="claude auth failed: $(head -1 "$tmp" | redact) — rotate kv/ai/claude via 'claude setup-token'"
  elif (( rc != 0 )); then
    reason="claude exited $rc: $(head -1 "$tmp" 2>/dev/null | redact)"
  elif [[ ! -s "$tmp" ]]; then
    reason="claude produced no output"
  elif ! grep -q '^## ' "$tmp"; then
    reason="claude output was not the expected markdown"
  else
    reason=""
  fi

  if [[ -z "$reason" ]]; then
    cat "$tmp" >>"$REPORT"
    log "claude analysis ok ($(wc -l <"$tmp") lines)"
  else
    printf '\n## Analysis\n\n> [!warning] Analysis unavailable\n> %s\n>\n> The metrics above are still accurate. See `%s`.\n' \
      "$reason" "$LOG" >>"$REPORT"
    log "WARN: $reason"
  fi
  rm -f "$tmp"
else
  printf '\n## Analysis\n\n> [!warning] Analysis unavailable\n> claude binary not found.\n' >>"$REPORT"
  log "WARN: claude binary missing"
fi

# ── 9. activity note entry ───────────────────────────────────────────────
if [[ ! -f "$ACTIVITY" ]]; then
  cat >"$ACTIVITY" <<EOF
---
tags:
  - type/log
  - area/homelab
date: $TODAY
---

# $TODAY Activity
EOF
fi

if ! grep -q "^## Fleet Update Check" "$ACTIVITY" 2>/dev/null; then
  cat >>"$ACTIVITY" <<EOF

## Fleet Update Check

- Automated weekly check ran across [[mimir]], [[avalon]], and the UniFi fleet
- [[mimir]]: ${repo_count} repo + ${aur_count} AUR updates pending, ${days_since} days since last full upgrade
$([[ "$bios_outdated" == "1" ]] && echo "- [[mimir]]: BIOS ${bios_latest} available (installed ${bios_installed}), review only")
$([[ "$polymath_new" == "1" ]] && echo "- [[mimir]]: **[[Polymath|PolyMath]] ${polymath_latest}** released (installed ${polymath_installed})")
- Containers: ${ctr_stale} images older than 180 days, ${ctr_restarting} restarting, ${ctr_unhealthy} unhealthy
- [[avalon]]: ${img_apply} container updates queued for the weekly run, ${img_hold} held$([[ "$truenas_train_eol" == "1" ]] && echo "; TrueNAS train at end of life, ${truenas_newer_train} needs approval")
- Full report: [[$TODAY-fleet-updates]]
EOF
fi

# ── 10. notify ───────────────────────────────────────────────────────────
urgency=normal
if (( days_since < 0 || days_since >= STALE_DAYS )) \
   || [[ "${ctr_restarting:-0}" != "0" ]] || [[ "${ctr_unhealthy:-0}" != "0" ]]; then
  urgency=critical
fi

if command -v notify-send >/dev/null; then
  notify-send --app-name="Fleet Updates" --urgency="$urgency" \
    --icon=system-software-update \
    "Fleet update check complete" \
    "mimir: ${repo_count} repo / ${aur_count} AUR
containers: ${ctr_stale} stale, ${ctr_restarting} restarting
avalon: ${img_apply} queued, ${img_hold} held$([[ "$polymath_new" == "1" ]] && printf '\nPolyMath %s released (installed %s)' "$polymath_latest" "$polymath_installed")$([[ "$bios_outdated" == "1" ]] && printf '\nBIOS %s available (installed %s)' "$bios_latest" "$bios_installed")
Report saved to Obsidian"
fi

log "=== run complete (urgency=$urgency) ==="
exit 0
